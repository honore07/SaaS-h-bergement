# Claude API — génération du rapport de diagnostic (optionnel : fallback scoring déterministe sans clé)
ANTHROPIC_API_KEY=

# URL publique du site (SEO / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Webhook n8n recevant les leads du diagnostic (optionnel, fire-and-forget)
# Workflow « GiteOuvert — Lead diagnostic »
N8N_WEBHOOK_URL=http://82.25.118.185:5678/webhook/giteouvert-diagnostic

# Brevo — création du contact après diagnostic (optionnel, fire-and-forget ;
# sans clé, aucun appel n'est effectué). Clé API v3 : https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Id numérique de la liste Brevo où ranger les leads diagnostic (optionnel)
BREVO_LIST_ID=
